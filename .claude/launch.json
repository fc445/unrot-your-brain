{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "unrot",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PYTHONPATH=src exec .venv/bin/python -m unrot.api --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "unrot-ui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ui", "run", "dev"],
      "port": 5173
    }
  ]
}
