# unrot configuration. Copy to `.env` in this directory; it is gitignored.
#
# Everything here is optional -- the tools run without any of it, and a real
# environment variable always beats what is written here, so
# `UNROT_MODEL=... python -m unrot.resolver run` overrides the file for one run.
#
# Check what is actually in effect with:  python -m unrot.resolver env

# Your OpenRouter key. OPENAI_API_KEY is also accepted.
OPENROUTER_API_KEY=

# Which model answers. Any model id your endpoint serves.
#   inclusionai/ling-3.0-flash  the default
#   anthropic/claude-sonnet-5   what the first live run was validated against
# The detector reads whole transcripts, so that is where cost actually lives --
# a cheaper model changes the bill far more than it changes the resolver.
UNROT_MODEL=inclusionai/ling-3.0-flash

# How long a reasoning model thinks before answering: low | medium | high, or
# empty to let the model decide. Sent to OpenRouter only. Default low. Higher
# can find subtler gaps and is slower and dearer.
# UNROT_REASONING_EFFORT=low

# Output ceiling per call, reasoning included. Default 8000. A call that hits
# it while still thinking is asked once more to answer directly, so this bounds
# how long a stuck model can run rather than failing it. Raise it with effort.
# UNROT_MAX_TOKENS=8000

# How many model calls may run at once: the chunks of one long session, and in
# the Mac app, sessions side by side. Each call is mostly waiting on the
# provider, so more at once finishes sooner for the same cost. Default 4, or 1
# for a local endpoint, which usually answers one request at a time.
# UNROT_CONCURRENCY=4

# OpenAI-compatible endpoint. Point this at a local server (Ollama, llama.cpp,
# LM Studio) to keep transcripts off the network entirely -- the PRD's
# local-only-analysis option is this line, not a rewrite. Any placeholder key
# will do in that case.
# UNROT_BASE_URL=http://localhost:11434/v1

# Optional tracing. Needs LANGSMITH_TRACING=true as well.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
