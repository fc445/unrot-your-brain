# unrot configuration. Copy to `.env` in this directory; it is gitignored.
#
# Everything here is optional -- the tools run without any of it, and a real
# environment variable always beats what is written here, so
# `UNROT_MODEL=... python -m unrot.resolver run` overrides the file for one run.
#
# Check what is actually in effect with:  python -m unrot.resolver env

# Your OpenRouter key. OPENAI_API_KEY is also accepted.
OPENROUTER_API_KEY=

# Which model answers. Any model id your endpoint serves.
#   anthropic/claude-sonnet-5   default -- what the live run was validated on
#   anthropic/claude-opus-5     stronger, slower, dearer
#   anthropic/claude-haiku-4-5  cheaper; the detector reads whole transcripts,
#                               so this is where cost actually lives
UNROT_MODEL=anthropic/claude-sonnet-5

# OpenAI-compatible endpoint. Point this at a local server (Ollama, llama.cpp,
# LM Studio) to keep transcripts off the network entirely -- the PRD's
# local-only-analysis option is this line, not a rewrite. Any placeholder key
# will do in that case.
# UNROT_BASE_URL=http://localhost:11434/v1

# Optional tracing. Needs LANGSMITH_TRACING=true as well.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
