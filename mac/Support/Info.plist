<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>unrot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<!-- Set from $(SRCROOT)/.. at build time, so a Debug build out of a
	     checkout can run the repo's own interpreter instead of requiring the
	     core to be re-frozen on every change. It resolves to a path that does
	     not exist on any other machine, which is the intended behaviour: a
	     shipped app must fall through to the bundled core. -->
	<key>UnrotDevRepoPath</key>
	<string>$(UNROT_DEV_REPO_PATH)</string>
	<!-- "dev" or "prod", from the UNROT_CHANNEL build setting. Recorded so a
	     built app says which it is -- packaging/dmg.sh checks it -- without
	     anyone having to run it. -->
	<key>UnrotChannel</key>
	<string>$(UNROT_CHANNEL)</string>
	<!-- Dev builds only: the default LangSmith key for the Developer tab's
	     tracing toggle, from the UNROT_DEV_LANGSMITH_API_KEY build setting.
	     Empty unless a build was given one; packaging/dmg.sh and release.sh
	     never pass one to a prod build and fail one that has it. -->
	<key>UnrotLangSmithKey</key>
	<string>$(UNROT_DEV_LANGSMITH_API_KEY)</string>
	<!-- "Add to unrot" in the Services menu of any app with a text selection.
	     macOS puts third-party items under Services, not at the top level of a
	     context menu, and that is where this is. NSRequiredContext is present
	     (and empty) so the item is enabled by default rather than hidden until
	     someone finds it in System Settings.

	     No NSKeyEquivalent. That key always implies Command and cannot express
	     Option, so the design's Option-Command-U cannot be a shipped default;
	     it is assigned in System Settings > Keyboard > Keyboard Shortcuts >
	     Services, which the app links to. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to unrot</string>
			</dict>
			<key>NSMessage</key>
			<string>addToUnrot</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
