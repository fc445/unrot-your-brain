<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed, and that is a decision rather than an omission. The app
	     spawns a bundled interpreter and reads ~/.claude and ~/.unrot; the
	     sandboxed version of that is survivable but expensive, and PR-29 parks
	     the question until distribution deliberately.

	     No code-signing exceptions. The Swift app needs none under the hardened
	     runtime; the frozen core it launches has its own, narrower file at
	     packaging/core.entitlements, so neither binary carries what only the
	     other needs. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
